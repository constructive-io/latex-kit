{
  "name": "latex-kit-monorepo",
  "version": "0.0.1",
  "packageManager": "pnpm@10.32.0",
  "author": "Constructive <developers@constructive.io>",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/constructive-io/latex-kit"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "clean": "pnpm -r --filter './packages/*' run clean",
    "test": "pnpm -r --filter './packages/*' run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r --filter './packages/*' exec tsc --noEmit -p tsconfig.json",
    "deps": "pnpm up -r -i -L",
    "policy": "pnpm-policy generate",
    "policy:check": "pnpm-policy check"
  },
  "devDependencies": {
    "@constructive-io/eslint-config": "^0.2.0",
    "@constructive-io/pnpm-policy": "^0.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.11",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.4.2",
    "lerna": "^8.2.3",
    "makage": "^0.8.0",
    "pnpm-policy": "^0.6.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
